# Copy to .env and adjust. All optional - defaults shown.
# MW_DATA_DIR=./data
# MW_ENABLE_SCHEDULER=1        # 0 when Task Scheduler / cron runs app.update
# MW_UPDATE_HOUR=6             # local hour for the in-process daily update
# MW_AUTH_ENABLED=0            # flip to 1 when subscriptions are implemented
# MW_ADMIN_TOKEN=              # set to enable POST /api/update
# MW_PORT=8000
